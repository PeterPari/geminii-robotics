      "sprite": "logos/sprite.svg"
    },
    "versions": {
      "fullColorOnBlack": "wordmark-full-color-on-dark.svg",
      "fullColorOnWhite": "wordmark-full-color-on-light.svg",
      "oneColorWhiteOnBlack": "wordmark-white.svg",
      "oneColorBlackOnWhiteOrTeal": "wordmark-black.svg"
