---
import PageHeading from "../components/PageHeading.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
    title: string;
    heading?: string;
    description: string;
    className?: string;
    noindex?: boolean;
}

const { title, heading = title.toUpperCase(), description, className, noindex = false } = Astro.props;
---

<BaseLayout
    title={`${title} | Geminii Robotics FTC 73845`}
    description={description}
    noindex={noindex}
    breadcrumbs={noindex ? [] : [{ name: title, path: Astro.url.pathname }]}
>
    <PageHeading heading={heading} className={className}>
        <slot name="subtitle"/>
    </PageHeading>
    <slot />
</BaseLayout>