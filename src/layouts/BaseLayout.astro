---
import NavigationBar from "../components/NavigationBar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	expandedNav?: boolean;
	/** Site-relative path or absolute URL of the social share image. */
	image?: string;
	imageAlt?: string;
	/** Keep the page out of search results (e.g. the 404 page). */
	noindex?: boolean;
	/** Breadcrumb trail below Home, e.g. [{ name: "About Us", path: "/about/" }]. */
	breadcrumbs?: { name: string; path: string }[];
	/** Extra schema.org nodes for this page (e.g. an FAQPage), merged into the site's JSON-LD graph. */
	schema?: Record<string, unknown>[];
}

const {
	title,
	expandedNav = false,
	description,
	image = "/og-image.png",
	imageAlt = "GEMINII wordmark: FIRST Tech Challenge Team 38977, The Browning School, New York City",
	noindex = false,
	breadcrumbs = [],
	schema = [],
} = Astro.props;

// Set as GitHub repository variables (Settings → Secrets and variables → Actions → Variables);
// the deploy workflow passes them to the build. Each tag is left out while its variable is unset.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const site = Astro.site!;
// GitHub Pages serves every page as a directory, so canonical URLs always end in a slash.
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(path, site).href;
const imageURL = new URL(image, site).href;
const siteName = "Geminii Robotics";

const orgId = new URL("/#organization", site).href;
const websiteId = new URL("/#website", site).href;

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SportsTeam",
			"@id": orgId,
			name: "Geminii Robotics",
			alternateName: ["Geminii Robotics 38977", "Geminii 38977", "FTC Team 38977", "Geminii", "GEMINII"],
			description:
				"Geminii Robotics is FIRST Tech Challenge (FTC) Team 38977, a student-led robotics team at The Browning School in New York City and an affiliate of Ultro Robotics.",
			url: new URL("/", site).href,
			logo: {
				"@type": "ImageObject",
				url: new URL("/icon-512.png", site).href,
				width: 512,
				height: 512,
			},
			image: new URL("/og-image.png", site).href,
			sport: "Robotics",
			foundingDate: "2026",
			email: "geminii-robotics@browning.edu",
			address: {
				"@type": "PostalAddress",
				streetAddress: "337 East 64th Street",
				addressLocality: "New York",
				addressRegion: "NY",
				postalCode: "10065",
				addressCountry: "US",
			},
			memberOf: {
				"@type": "SportsOrganization",
				name: "FIRST Tech Challenge",
				url: "https://www.firstinspires.org/robotics/ftc",
			},
			parentOrganization: {
				"@type": "EducationalOrganization",
				name: "The Browning School",
				url: "https://browning.edu",
			},
			sameAs: ["https://www.instagram.com/geminii.robotics/"],
		},
		{
			"@type": "WebSite",
			"@id": websiteId,
			name: "Geminii Robotics 38977",
			alternateName: ["Geminii Robotics", "Geminii 38977", "Geminii"],
			url: new URL("/", site).href,
			inLanguage: "en-US",
			publisher: { "@id": orgId },
		},
		{
			"@type": "WebPage",
			"@id": `${canonicalURL}#webpage`,
			url: canonicalURL,
			name: title,
			description,
			inLanguage: "en-US",
			isPartOf: { "@id": websiteId },
			about: { "@id": orgId },
			primaryImageOfPage: { "@type": "ImageObject", url: imageURL },
		},
		...(breadcrumbs.length
			? [
					{
						"@type": "BreadcrumbList",
						itemListElement: [{ name: "Home", path: "/" }, ...breadcrumbs].map((crumb, i) => ({
							"@type": "ListItem",
							position: i + 1,
							name: crumb.name,
							item: new URL(crumb.path, site).href,
						})),
					},
				]
			: []),
		...schema,
	],
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="preload" href="/assets/fonts/Arvo-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/assets/fonts/Arvo-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
		<meta name="description" content={description} />
		{!noindex && <link rel="canonical" href={canonicalURL} />}
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		<meta name="theme-color" content="#000000" />
		<meta name="author" content="Geminii Robotics" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
		{bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}

		<!-- Open Graph (Facebook, iMessage, LinkedIn, Slack, Discord…) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonicalURL} />}
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content={imageAlt} />

		{!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

		{gaMeasurementId && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
				<script is:inline define:vars={{ gaMeasurementId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag("js", new Date());
					gtag("config", gaMeasurementId);
				</script>
			</>
		)}
		{expandedNav && (
			<script is:inline>
				// Home intro gate: runs before first paint so nav/content never flash.
				// Plays once per tab session, skipped for reduced motion.
				try {
					if (
						!sessionStorage.getItem("introSeen") &&
						!matchMedia("(prefers-reduced-motion: reduce)").matches
					) {
						sessionStorage.setItem("introSeen", "1");
						document.documentElement.classList.add("intro-pending");
						// Safety net: never leave the page hidden if the intro script fails.
						setTimeout(function () {
							document.documentElement.classList.remove("intro-pending");
						}, 6000);
					}
				} catch (e) {}
			</script>
		)}
		<slot name="head" />
	</head>
	<body>
		<NavigationBar expandedNav={expandedNav}/>
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
