---
import MobileMenu from "./MobileMenu.astro";

interface NavItem {
    title: string;
    href: string;
}

const { expandedNav = false } = Astro.props;

const navHeight = 20;
const expandedHeight = expandedNav ? 48 : 20;

/*
    PLEASE ASTRO FIX THIS
    const tailwindNavHeight = `h-${navHeight.toString()}`;
    const tailwindExpandedHeight = `h-${expandedHeight.toString()}`;
*/
const tailwindNavHeight = "h-20";
const tailwindExpandedHeight = expandedNav ? "h-48" : "h-20";

const leftNavItems: NavItem[] = [
    { title: "About", href: "/about/" },
];

const rightNavItems: NavItem[] = [
    { title: "Outreach", href: "/outreach/" },
];

const givingItem: NavItem = { title: "Giving", href: "/giving/" };

const currentPath = Astro.url.pathname;
---

<nav
    id="fullnav"
    {...expandedNav && {
        "data-navheight": navHeight.toString(),
        "data-expandedheight": expandedHeight.toString()
    }}
    class={`bg-black/60 font-display font-medium max-sm:h-20 ${tailwindExpandedHeight} backdrop-blur-sm flex ${expandedNav ? "fixed inset-x-0 border-b-black/60" : "sticky border-b-gray-200/30"} max-lg:items-center max-lg:justify-center top-0 w-full transition-colors duration-100 z-10 border-b-2 shadow-sm`}
>
    <div
        class={`text-white text-lg ${tailwindNavHeight} flex flex-1 items-center justify-end`}
    >
        {
            leftNavItems.map((item) => (
                <a
                    href={item.href}
                    class={`px-6 py-4 hidden lg:inline ${currentPath === item.href ? "font-extrabold text-white" : "hover:text-gray-300 transition-colors"}`}
                >
                    {item.title}
                </a>
            ))
        }
    </div>
    <a href="/" class={`group flex-none flex items-center justify-center ${tailwindNavHeight} max-w-full`} aria-label="GEMINII logo">
        <span class="relative inline-block">
            <img id="nav-wordmark" fetchpriority="high" src="/assets/brand/wordmark-white.svg" data-color-src="/assets/brand/wordmark-full-color-on-dark.svg" alt="GEMINII" title="GEMINII" aria-label="GEMINII" width="170" height="48" class="h-12 w-auto block" />
            <img src="/assets/brand/wordmark-full-color-on-dark.svg" alt="" aria-hidden="true" width="170" height="48" class="absolute inset-0 h-12 w-auto opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 group-focus-visible:opacity-100" />
        </span>
    </a>
    <div
        class={`text-white text-lg ${tailwindNavHeight} flex flex-1 items-center justify-between`}
    >
        <div class="justify-self-start">
            {
                rightNavItems.map((item) => (
                    <a
                        href={item.href}
                        class={`px-6 py-4 hidden lg:inline ${currentPath === item.href ? "font-extrabold text-white" : "hover:text-gray-300"}`}
                    >
                        {item.title}
                    </a>
                ))
            }
        </div>
        <div class="justify-self-end flex items-center">
            <a
                href={givingItem.href}
                class="hidden lg:inline-block mr-6 border-3 border-geminii-600 bg-geminii-600 px-6 py-2 text-base text-black hover:bg-transparent hover:text-white transition-colors focus:ring-3 focus:ring-white focus:outline-hidden"
                aria-current={currentPath === givingItem.href ? "page" : undefined}
            >
                {givingItem.title}
            </a>
            <MobileMenu items={[...leftNavItems, ...rightNavItems, givingItem]} currentPath={currentPath} />
        </div>
    </div>
</nav>

{expandedNav && (
    <script>
        // Home intro: centered wordmark breathes (slow grow), then shrinks into the nav slot.
        const BREATHE_MS = 1800;
        const SHRINK_MS = 500;
        const REVEAL_MS = 450; // matches intro-fade in global.css
        const BREATHE_GROW = 1.12;
        const START_WIDTH = 0.7; // fraction of viewport width, capped below
        const START_MAX_PX = 560;

        const root = document.documentElement;

        async function playIntro() {
            const navLogo = document.getElementById("nav-wordmark") as HTMLImageElement | null;
            if (!navLogo) return finish();

            // Intro plays in full color; the nav slot itself is white (see markup).
            const colorSrc = navLogo.dataset.colorSrc ?? navLogo.src;
            const colorImg = new Image();
            colorImg.src = colorSrc;

            await Promise.all([
                navLogo.decode().catch(() => {}),
                colorImg.decode().catch(() => {}),
                document.fonts?.ready ?? Promise.resolve(),
            ]);

            const target = navLogo.getBoundingClientRect();
            const vw = window.innerWidth;
            const vh = window.innerHeight;

            const dx = vw / 2 - (target.left + target.width / 2);
            const dy = vh / 2 - (target.top + target.height / 2);
            const base = Math.min(vw * START_WIDTH, START_MAX_PX) / target.width;
            const peak = base * BREATHE_GROW;

            // Lay the clone out at its largest size and only scale DOWN from there.
            // Scaling a small-layout image up makes browsers stretch a low-res raster (blurry).
            const W = target.width * peak;
            const H = target.height * peak;
            const at = (s: number) => `translate(${dx}px, ${dy}px) scale(${s / peak})`;

            const clone = document.createElement("img");
            clone.src = colorSrc;
            clone.alt = "";
            clone.setAttribute("aria-hidden", "true");
            clone.className = "intro-logo";
            Object.assign(clone.style, {
                left: `${target.left + target.width / 2 - W / 2}px`,
                top: `${target.top + target.height / 2 - H / 2}px`,
                width: `${W}px`,
                height: `${H}px`,
                transform: at(base),
            });
            document.body.appendChild(clone);
            await clone.decode().catch(() => {});

            const breathe = clone.animate(
                [{ transform: at(base) }, { transform: at(peak) }],
                { duration: BREATHE_MS, easing: "ease-in-out", fill: "forwards" },
            );
            await breathe.finished;

            const shrink = clone.animate(
                [
                    { transform: at(peak) },
                    { transform: `translate(0px, 0px) scale(${1 / peak})` },
                ],
                { duration: SHRINK_MS, easing: "cubic-bezier(0.7, 0, 0.2, 1)", fill: "forwards" },
            );
            await shrink.finished;

            // Reveal page under the clone; as the text fades in, the clone fades out
            // to the white nav logo beneath it, then gets dropped.
            root.classList.remove("intro-pending");
            root.classList.add("intro-reveal");
            clone.animate([{ opacity: 1 }, { opacity: 0 }], {
                duration: REVEAL_MS,
                easing: "ease-out",
                fill: "forwards",
            });
            setTimeout(() => {
                clone.remove();
                root.classList.remove("intro-reveal");
            }, REVEAL_MS + 10);
        }

        function finish() {
            root.classList.remove("intro-pending");
        }

        if (root.classList.contains("intro-pending")) {
            window.scrollTo(0, 0);
            playIntro().catch(finish);
        }
    </script>
    <script>
        const navbar = document.getElementById("fullnav");

        const logoMin = parseInt(navbar?.dataset?.navheight ?? "20");
        const logoMax = parseInt(navbar?.dataset?.expandedheight ?? "48");

        const scrollScale = 0.25 * parseFloat(getComputedStyle(document.documentElement).fontSize);

        let ticking = false;

        window.addEventListener("scroll", () => {
            // Sync animation with repaints
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    const scrollPosition = window.scrollY;
                    const logoSize = Math.max(
                        logoMin * scrollScale,
                        logoMax * scrollScale - scrollPosition,
                    );

                    if (navbar) navbar.style.height = `${logoSize}px`;
                    if (logoMax * scrollScale - scrollPosition <= logoMin * scrollScale) {
                        navbar?.classList.add("border-b-gray-200/30");
                        navbar?.classList.remove("bg-black/40");
                    } else {
                        navbar?.classList.add("bg-black/40");
                        navbar?.classList.remove("border-b-gray-200/30");
                    }
                    ticking = false;
                });

                ticking = true;
            }
        });
    </script>
)}