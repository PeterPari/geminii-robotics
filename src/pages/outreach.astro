---
import MainLayout from "../layouts/MainLayout.astro";
import Paragraph from "../components/Paragraph.astro";
import Card from "../components/Card.astro";
import Link from "../components/Link.astro";
import Button from "../components/Button.astro";
---

<MainLayout title="Outreach" description="Geminii Robotics outreach: mentoring Intro to Engineering students and visiting NYC nursing homes with the Carter Burden Network to share FIRST robotics.">
	<Paragraph slot="subtitle">
		Geminii is built around more than just building robots. Our goal is to
		mentor younger students before they go into harder robotics to be
		reliable and knowledgeable while connecting with the community.
	</Paragraph>
	<section class="relative flex justify-center my-16 w-full" aria-labelledby="programs-heading">
		<h2 id="programs-heading" class="sr-only">Our outreach programs</h2>
		<div class="flex flex-wrap justify-center content-start gap-4 w-auto">
			<Card title="Intro to Engineering">
				<p slot="description">
					We work with the 10<sup>th</sup> Grade curriculum class
					<em>Intro to Engineering</em> in order to help students ease
					into robotics without being thrown into it.
				</p>
			</Card>
			<Card title="Carter Burden Network">
				<p slot="description">
					Geminii is going to nursing homes through the <Link
						href="https://www.carterburdennetwork.org/"
						external={true}>Carter Burden Network</Link
					> to bridge the technology gap and explain what we do to older
					folks to spread the word of FIRST. We're also designing
					bracelets for people with cancer.
				</p>
			</Card>
		</div>
	</section>
	<section class="flex flex-col items-center text-center px-4 pb-16 gap-6">
		<Paragraph>
			Our outreach is funded by the team itself. <Link href="/about/">Learn more about Geminii</Link>,
			or help us reach more people with a gift.
		</Paragraph>
		<Button text="SUPPORT OUR OUTREACH" href="/giving/" />
	</section>
</MainLayout>
