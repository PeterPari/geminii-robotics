---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Paragraph from "../components/Paragraph.astro";
import Link from "../components/Link.astro";
import Socials from "../components/Socials.astro";
import Picture from "astro/components/Picture.astro";
import landingGraphic from "../assets/robotics.webp";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Geminii Robotics 73845",
  alternateName: ["Geminii Robotics", "Geminii 73845", "Geminii"],
  url: Astro.site,
}
---

<BaseLayout
	title="Geminii Robotics ♊︎ FTC 73845"
	expandedNav="true"
	description="Geminii Robotics is a FIRST Tech Challenge robotics team based at The Browning School. We are a student-led team that aims to engineer for humanity."
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<div
		id="landing"
		class="relative flex flex-col items-center justify-center min-h-dvh w-dvw px-6 pt-48 pb-24 bg-gradient-to-b from-black from-30% to-geminii-950 to-90%"
	>
		<div
			id="about"
			class="flex flex-col justify-center items-center text-center w-9/10 space-y-8"
		>
			<h2 class="text-white text-4xl font-display font-extrabold">
				What is Geminii?
			</h2>
			<Paragraph>
				Geminii Robotics is a <strong>FIRST Tech Challenge</strong> (FTC)
				robotics team based at <Link href="https://browning.edu" external={true}>The Browning School</Link>, a New York City all-boys school.
			</Paragraph>
			<Paragraph>
				With our <strong>student-led</strong>, innovative designs and
				high-performing autonomous projects, our ultimate goal is to use the
				skills we learned in FTC to <strong
					class="whitespace-nowrap">engineer for humanity.</strong
				>
			</Paragraph>
			<Button text="ABOUT US" href="/about/" />
		</div>
		<Socials rotation="vertical" id="home-socials" className="fixed bottom-6 right-6 z-10 will-change-transform" />
	</div>
	<script>
		// Handoff: once the footer's pill (#footer-socials) is fully on screen, the floating
		// pill's frame dissolves while its icons glide into the footer pill, whose frame then
		// fades in around them. The gliding icons are the footer's own (offset to start where
		// the floating ones were), so they ride the scroll natively. Once the footer pill has
		// left the screen, the floating pill rises back in. Nothing runs per scroll frame.
		const overlay = document.getElementById("home-socials");
		const target = document.getElementById("footer-socials");

		if (overlay && target) {
			const root = document.documentElement;
			root.classList.add("socials-morph");

			const links = Array.from(overlay.querySelectorAll("a"));
			const targetLinks = Array.from(target.querySelectorAll("a"));
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

			const GLIDE = 700; // ms for the icons to travel
			const STAGGER = 60; // ms between the two icons setting off
			const GLIDE_EASING = "cubic-bezier(.65, 0, .35, 1)";
			const RISE = 450; // ms for the floating pill to come back
			const RISE_EASING = "cubic-bezier(.2, .7, .2, 1)";

			// Both pills share classes, so one read gives the frame colours for each.
			const cs = getComputedStyle(overlay);
			const frameOn: Keyframe = { backgroundColor: cs.backgroundColor, borderColor: cs.borderTopColor };
			const frameOff: Keyframe = { backgroundColor: "transparent", borderColor: "transparent" };

			let docked = false;
			let running: Animation[] = [];
			let run = 0;

			// Drop any in-flight animation and its inline overrides.
			function stop() {
				run++;
				running.forEach((a) => a.cancel());
				running = [];
				[overlay!, target!, ...links].forEach((el) => (el.style.visibility = ""));
				root.classList.remove("socials-animating");
			}

			// Final state is pure CSS: the state class decides which pill is visible.
			function settle() {
				root.classList.toggle("socials-docked", docked);
				stop();
			}

			function play(anims: Animation[]) {
				running = anims;
				const id = run;
				Promise.all(anims.map((a) => a.finished)).then(
					() => id === run && settle(),
					() => {}, // cancelled by a newer run
				);
			}

			function dock() {
				const starts = links.map((a) => a.getBoundingClientRect());
				const ends = targetLinks.map((a) => a.getBoundingClientRect());
				root.classList.add("socials-animating");
				overlay!.style.visibility = "visible";
				target!.style.visibility = "visible";
				// The footer's icons take over from here; hide the floating ones.
				links.forEach((a) => (a.style.visibility = "hidden"));
				play([
					overlay!.animate([frameOn, frameOff], { duration: GLIDE * 0.35, easing: "ease-out", fill: "both" }),
					// Frame forms around the icons as they land.
					target!.animate([frameOff, frameOn], {
						duration: GLIDE * 0.4 + STAGGER,
						delay: GLIDE * 0.6,
						easing: "ease-out",
						fill: "both",
					}),
					...targetLinks.map((a, i) => {
						const s = starts[i];
						const e = ends[i];
						const from = `translate(${s.left - e.left}px, ${s.top - e.top}px) scale(${s.width / e.width}, ${s.height / e.height})`;
						return a.animate(
							[
								{ transform: from, transformOrigin: "0 0" },
								{ transform: "none", transformOrigin: "0 0" },
							],
							{ duration: GLIDE, delay: i * STAGGER, easing: GLIDE_EASING, fill: "both" },
						);
					}),
				]);
			}

			// The footer pill is off screen by now, so the floating pill just rises back in.
			function undock() {
				root.classList.add("socials-animating");
				overlay!.style.visibility = "visible";
				play([
					overlay!.animate(
						[
							{ opacity: 0, transform: "translateY(12px) scale(.94)" },
							{ opacity: 1, transform: "none" },
						],
						{ duration: RISE, easing: RISE_EASING, fill: "both" },
					),
				]);
			}

			function set(next: boolean, animate: boolean) {
				if (next === docked) return;
				docked = next;
				stop();
				if (!animate || reduceMotion.matches) settle();
				else if (docked) dock();
				else undock();
			}

			// Dock once the footer pill is fully visible, undock once it is fully gone:
			// the gap between the two is the hysteresis band. The first callback
			// reflects the load position, so it snaps without animating.
			let first = true;
			new IntersectionObserver(
				([entry]) => {
					if (entry.intersectionRatio >= 0.99) set(true, !first);
					else if (!entry.isIntersecting) set(false, !first);
					first = false;
				},
				{ threshold: [0, 0.99] },
			).observe(target);
		}
	</script>
</BaseLayout>
