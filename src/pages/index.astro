---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Paragraph from "../components/Paragraph.astro";
import Link from "../components/Link.astro";
import Socials from "../components/Socials.astro";
import Picture from "astro/components/Picture.astro";
import landingGraphic from "../assets/robotics.webp";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Geminii Robotics 73845",
  alternateName: ["Geminii Robotics", "Geminii 73845", "Geminii"],
  url: Astro.site,
}
---

<BaseLayout
	title="Geminii Robotics ♊︎ FTC 73845"
	expandedNav="true"
	description="Geminii Robotics is a FIRST Tech Challenge robotics team based at The Browning School. We are a student-led team that aims to engineer for humanity."
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<div
		id="landing"
		class="relative flex flex-col items-center justify-center min-h-dvh w-dvw px-6 pt-48 pb-24 bg-gradient-to-b from-black from-30% to-geminii-950 to-90%"
	>
		<div
			id="about"
			class="flex flex-col justify-center items-center text-center w-9/10 space-y-8"
		>
			<h2 class="text-white text-4xl font-display font-extrabold">
				What is Geminii?
			</h2>
			<Paragraph>
				Geminii Robotics is a <strong>FIRST Tech Challenge</strong> (FTC)
				robotics team based at <Link href="https://browning.edu" external={true}>The Browning School</Link>, a New York City all-boys school.
			</Paragraph>
			<Paragraph>
				With our <strong>student-led</strong>, innovative designs and
				high-performing autonomous projects, our ultimate goal is to use the
				skills we learned in FTC to <strong
					class="whitespace-nowrap">engineer for humanity.</strong
				>
			</Paragraph>
			<Button text="ABOUT US" href="/about/" />
		</div>
		<Socials rotation="vertical" id="home-socials" className="fixed bottom-6 right-6 z-10 will-change-transform" />
	</div>
	<script>
		// Handoff: the floating pill glides into the footer's pill (#footer-socials) once
		// that pill is fully on screen, and back out once it has left the screen. The
		// animation is time-based and only touches transform/opacity, so it runs on the
		// compositor instead of chasing the scroll position from the main thread.
		const overlay = document.getElementById("home-socials");
		const target = document.getElementById("footer-socials");

		if (overlay && target) {
			const root = document.documentElement;
			root.classList.add("socials-morph");

			const DURATION = 450;
			const EASING = "cubic-bezier(.2, .8, .2, 1)";
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

			let docked = false;
			let running: Animation[] = [];

			// Transform that lays `from`'s box over `to`'s box (both centred origins).
			const flip = (from: DOMRect, to: DOMRect) => {
				const dx = to.left + to.width / 2 - (from.left + from.width / 2);
				const dy = to.top + to.height / 2 - (from.top + from.height / 2);
				return `translate(${dx}px, ${dy}px) scale(${to.width / from.width}, ${to.height / from.height})`;
			};

			// Final state is pure CSS: the state class decides which pill is visible.
			function settle() {
				root.classList.toggle("socials-docked", docked);
				running.forEach((a) => a.cancel());
				running = [];
				overlay!.style.visibility = "";
				target!.style.visibility = "";
			}

			function set(next: boolean, animate: boolean) {
				if (next === docked) return;
				docked = next;

				// Changed direction mid-flight: run the same animation back instead of jumping.
				if (running.length) {
					running.forEach((a) => a.reverse());
					return;
				}
				if (!animate || reduceMotion.matches) {
					settle();
					return;
				}

				const from = overlay!.getBoundingClientRect();
				const to = target!.getBoundingClientRect();
				// Keyframes are written for docking and swapped for undocking (rather than
				// `direction: "reverse"`, which would also flip the easing to an ease-in).
				const path = (home: Keyframe, away: Keyframe) => (docked ? [home, away] : [away, home]);
				const opts: KeyframeAnimationOptions = { duration: DURATION, easing: EASING, fill: "both" };
				overlay!.style.visibility = "visible";
				target!.style.visibility = "visible";
				running = [
					overlay!.animate(
						path({ transform: "none", opacity: 1 }, { transform: flip(from, to), opacity: 0 }),
						opts,
					),
					target!.animate(
						path({ transform: flip(to, from), opacity: 0 }, { transform: "none", opacity: 1 }),
						opts,
					),
				];
				running[0].onfinish = settle;
			}

			// Dock once the footer pill is fully visible, undock once it is fully gone:
			// the gap between the two is the hysteresis band. The first callback
			// reflects the load position, so it snaps without animating.
			let first = true;
			new IntersectionObserver(
				([entry]) => {
					if (entry.intersectionRatio >= 0.99) set(true, !first);
					else if (!entry.isIntersecting) set(false, !first);
					first = false;
				},
				{ threshold: [0, 0.99] },
			).observe(target);
		}
	</script>
</BaseLayout>
