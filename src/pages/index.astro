---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Paragraph from "../components/Paragraph.astro";
import Link from "../components/Link.astro";
import Socials from "../components/Socials.astro";
import Picture from "astro/components/Picture.astro";
import landingGraphic from "../assets/robotics.webp";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Geminii Robotics 73845",
  alternateName: ["Geminii Robotics", "Geminii 73845", "Geminii"],
  url: Astro.site,
}
---

<BaseLayout
	title="Geminii Robotics ♊︎ FTC 73845"
	expandedNav="true"
	description="Geminii Robotics is a FIRST Tech Challenge robotics team based at The Browning School. We are a student-led team that aims to engineer for humanity."
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<div
		id="landing"
		class="relative flex flex-col items-center justify-center min-h-dvh w-dvw px-6 pt-48 pb-24 bg-gradient-to-b from-black from-30% to-geminii-950 to-90%"
	>
		<div
			id="about"
			class="flex flex-col justify-center items-center text-center w-9/10 space-y-8"
		>
			<h2 class="text-white text-4xl font-display font-extrabold">
				What is Geminii?
			</h2>
			<Paragraph>
				Geminii Robotics is a <strong>FIRST Tech Challenge</strong> (FTC)
				robotics team based at <Link href="https://browning.edu" external={true}>The Browning School</Link>, a New York City all-boys school.
			</Paragraph>
			<Paragraph>
				With our <strong>student-led</strong>, innovative designs and
				high-performing autonomous projects, our ultimate goal is to use the
				skills we learned in FTC to <strong
					class="whitespace-nowrap">engineer for humanity.</strong
				>
			</Paragraph>
			<Button text="ABOUT US" href="/about/" />
		</div>
		<Socials rotation="vertical" id="home-socials" className="fixed bottom-6 right-6 z-10 will-change-transform" />
	</div>
	<script>
		// Scroll-linked morph: the vertical pill turns landscape and settles into the
		// footer's pill (#footer-socials), which is hidden once this script runs.
		type Box = { x: number; y: number; w: number; h: number };

		const overlay = document.getElementById("home-socials");
		const target = document.getElementById("footer-socials");

		if (overlay && target) {
			const root = document.documentElement;
			root.classList.add("socials-morph");

			const links = Array.from(overlay.querySelectorAll("a"));
			const targetLinks = Array.from(target.querySelectorAll("a"));

			// All geometry is read once in measure() (footer boxes in document space), so
			// update() never touches layout: it only writes transform/size per frame.
			const box = (el: Element): Box => {
				const r = el.getBoundingClientRect();
				return { x: r.left, y: r.top, w: r.width, h: r.height };
			};
			const lerp = (a: Box, b: Box, p: number): Box => ({
				x: a.x + (b.x - a.x) * p,
				y: a.y + (b.y - a.y) * p,
				w: a.w + (b.w - a.w) * p,
				h: a.h + (b.h - a.h) * p,
			});

			let restPill: Box; // viewport x/size; y is derived from bottomGap + innerHeight
			let restLinks: Box[]; // relative to the pill's outer top-left
			let bottomGap = 0;
			let borderX = 0;
			let borderY = 0;
			let footerPill: Box; // document space
			let footerLinks: Box[]; // document space
			let docHeight = 0;
			let docWidth = 0;
			let morphing = false;
			let ticking = false;
			let progress = 0;
			const DOWN_DIST = 240; // px from page bottom where the morph into the footer pill runs
			const UP_RETURN = 260; // px of scroll-up, after the footer pill leaves the viewport, to return home
			const smooth = (x: number) => {
				const c = Math.min(1, Math.max(0, x));
				return c * c * (3 - 2 * c);
			};

			function reset() {
				morphing = false;
				overlay!.removeAttribute("style");
				links.forEach((a) => a.removeAttribute("style"));
			}

			function measure() {
				reset();
				const sx = window.scrollX;
				const sy = window.scrollY;
				const inDoc = (b: Box): Box => ({ ...b, x: b.x + sx, y: b.y + sy });
				const pill = box(overlay!);
				restPill = pill;
				restLinks = links.map((a) => {
					const b = box(a);
					return { ...b, x: b.x - pill.x, y: b.y - pill.y };
				});
				bottomGap = window.innerHeight - (pill.y + pill.h);
				// Absolute children sit inside the border, so offset by it.
				borderX = overlay!.clientLeft;
				borderY = overlay!.clientTop;
				footerPill = inDoc(box(target!));
				footerLinks = targetLinks.map((a) => inDoc(box(a)));
				docHeight = document.documentElement.scrollHeight;
				docWidth = window.innerWidth;
			}

			function update() {
				const vh = window.innerHeight;
				const scrollY = window.scrollY;
				const maxScroll = docHeight - vh;
				const s = Math.max(0, maxScroll - scrollY); // distance from page bottom
				// Footer pill's top leaves the viewport once s >= sOff.
				const sOff = vh - (footerPill.y - maxScroll);
				// Hysteresis: progress is held inside a band so it stays home until near
				// the bottom while scrolling down, and rides the footer pill until it is
				// off-screen while scrolling up.
				// Clamp both ramps to the scrollable range so short pages still reach home at the top.
				const downDist = Math.max(1, Math.min(DOWN_DIST, maxScroll * 0.8));
				const upEnd = Math.min(sOff + UP_RETURN, maxScroll);
				const upStart = Math.min(sOff, upEnd * 0.5);
				const lo = smooth(1 - s / downDist); // scrolling down: late start
				const hi = 1 - smooth((s - upStart) / Math.max(1, upEnd - upStart)); // scrolling up: late release
				progress = Math.min(hi, Math.max(lo, progress));
				const p = progress;

				if (p === 0) {
					if (morphing) reset();
					return;
				}

				if (!morphing) {
					morphing = true;
					Object.assign(overlay!.style, { display: "block", right: "auto", bottom: "auto", left: "0", top: "0" });
					links.forEach((a) => Object.assign(a.style, { position: "absolute", margin: "0", left: "0", top: "0" }));
				}

				// Never let the overlay leave the screen: while scrolling up, the footer pill
				// drops below the viewport before progress releases, so clamp its target to the
				// same bottom gap the resting pill has.
				const footerY = footerPill.y - scrollY;
				const dy = Math.min(0, vh - bottomGap - footerPill.h - footerY);
				const rest: Box = { ...restPill, y: vh - bottomGap - restPill.h };
				const pill = lerp(rest, { ...footerPill, y: footerY + dy }, p);
				overlay!.style.transform = `translate3d(${pill.x}px, ${pill.y}px, 0)`;
				overlay!.style.width = `${pill.w}px`;
				overlay!.style.height = `${pill.h}px`;

				links.forEach((a, i) => {
					const r = restLinks[i];
					const f = footerLinks[i];
					const l = lerp({ ...r, x: rest.x + r.x, y: rest.y + r.y }, { ...f, y: f.y - scrollY + dy }, p);
					a.style.transform = `translate3d(${l.x - pill.x - borderX}px, ${l.y - pill.y - borderY}px, 0)`;
					a.style.width = `${l.w}px`;
					a.style.height = `${l.h}px`;
				});
			}

			function schedule() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					update();
					ticking = false;
				});
			}

			// Re-measure synchronously (before paint) so the pill never flashes at rest.
			function remeasure() {
				measure();
				update();
			}

			window.addEventListener("scroll", schedule, { passive: true });
			// Mobile browsers fire height-only resizes as the toolbar collapses mid-scroll;
			// update() reads innerHeight itself, so only a width change needs a re-measure.
			window.addEventListener("resize", () => {
				if (window.innerWidth !== docWidth) remeasure();
				else schedule();
			});
			// Late layout shifts (fonts, images) move the footer target.
			new ResizeObserver(() => {
				if (document.documentElement.scrollHeight !== docHeight) remeasure();
			}).observe(document.body);
			remeasure();
		}
	</script>
</BaseLayout>
